# Maintainer: Willmar Knikker <Willmar.Knikker@topicus.nl>
#
# Fork build: tracks the main branch of https://github.com/WM-Knikker/aws-keyhub,
# which carries features not (yet) accepted upstream. The version is derived
# from the upstream base release plus the fork's commit count, e.g.
# 2.15.0.wm.r3.g07d983d, so it is recognisable as the fork build.
#
# To move to a new upstream base release, update _basever below.

_pkgname=aws-keyhub
_basever=2.15.0
pkgname=aws-keyhub-wm
pkgver=2.15.0.wm
pkgrel=1
pkgdesc='CLI login helper for the AWS CLI using SAML federated login with Topicus KeyHub'
arch=('x86_64' 'aarch64')
url='https://github.com/WM-Knikker/aws-keyhub'
license=('Apache-2.0')
depends=('glibc')
makedepends=('go' 'git')
provides=("$_pkgname=$_basever")
conflicts=('aws-keyhub')
optdepends=('aws-cli-v2: use the generated credentials with the AWS CLI')
source=("$_pkgname::git+$url.git#branch=main")
sha256sums=('SKIP')
options=('!debug')

pkgver() {
  cd "$_pkgname"
  printf '%s.wm.r%s.g%s' "$_basever" \
    "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$_pkgname"
  go mod download -x
}

build() {
  cd "$_pkgname"
  local cmd_pkg='github.com/topicuskeyhub/aws-keyhub/cmd'
  local go_version
  go_version=$(go env GOVERSION)

  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"

  go build \
    -ldflags "-linkmode external -X $cmd_pkg.GitTag=v$pkgver -X $cmd_pkg.GoVersion=$go_version" \
    -o build/ .
}

package() {
  cd "$_pkgname"
  install -Dm755 build/$_pkgname -t "$pkgdir/usr/bin/"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$_pkgname/"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$_pkgname/"
}
